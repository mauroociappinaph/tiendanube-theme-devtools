# Tienda Nube Theme DevTools — Environment Variables

# Path to the nube-cli binary (optional, defaults to PATH discovery)
NUBE_CLI_PATH=

# Runtime environment: "development" or "production"
# In production, dev-only manifest keys (key, debugger) are stripped
NODE_ENV=development

# Enable debug logging in the native host
DEBUG=false

# Chrome Web Store API credentials (required for CI/release)
CHROME_WEBSTORE_CLIENT_ID=
CHROME_WEBSTORE_CLIENT_SECRET=
CHROME_WEBSTORE_REFRESH_TOKEN=
