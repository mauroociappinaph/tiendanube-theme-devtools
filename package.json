{
  "name": "tiendanube-theme-devtools",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome DevTools extension for Tiendanube theme development",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "extension",
    "native-host"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:host:linux": "npm run build:host -- --os=linux",
    "build:host:macos": "npm run build:host -- --os=macos",
    "build:host:windows": "npm run build:host -- --os=windows",
    "build:all": "npm run build && npm run build:host:linux && npm run build:host:macos && npm run build:host:windows",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json -p tsconfig.native-host.json",
    "typecheck:ext": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:host": "tsc --noEmit -p tsconfig.native-host.json",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:host": "vitest run --config vitest.native-host.config.ts",
    "zip": "node scripts/build-zip.mjs",
    "clean": "rm -rf dist/",
    "validate:env": "node scripts/validate-env.js",
    "validate:arch": "madge --circular --extensions ts src/",
    "audit:deps": "npm audit --audit-level=high",
    "validate:all": "npm run lint && npm run format && npm run typecheck && npm run test && npm run validate:arch && npm run audit:deps",
    "prebuild": "npm run validate:env",
    "release": "standard-version --release-as",
    "release:patch": "npm run release patch",
    "release:minor": "npm run release minor",
    "release:major": "npm run release major",
    "postrelease": "git push --follow-tags origin main && npm run build:all && npm run zip"
  },
  "dependencies": {
    "preact": "^10.25.0",
    "@preact/signals": "^1.3.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "~5.5.0",
    "esbuild": "^0.24.0",
    "@types/chrome": "^0.0.258",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "prettier": "^3.3.0",
    "jsdom": "^24.0.0",
    "madge": "^7.0.0",
    "standard-version": "^9.5.0"
  },
  "_moduleAliases": {
    "@shared": "src/shared",
    "@background": "src/background",
    "@devtools": "src/devtools",
    "@content": "src/content",
    "@native-host": "src/native-host"
  }
}
