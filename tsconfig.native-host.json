{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src/native-host",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@native-host/*": ["src/native-host/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/native-host/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/native-host/**/*.test.ts"
  ]
}
